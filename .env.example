# Copie este arquivo para .env e preencha os valores.

# PIN que libera o painel do organizador.
ORGANIZADOR_PIN="buzios2026"

# Segredo do cookie de sessão do organizador. Use um valor aleatório e longo.
APP_SECRET="troque-este-segredo-antes-de-publicar"

# Banco na nuvem (Turso), usado em produção na Vercel.
# Sem estas duas variáveis, o app usa o arquivo local prisma/dev.db.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
